@@ -26,6 +26,11 @@ metadata:
 data:
   ds-start.sh: |
     #!/bin/bash
+    # On OpenShift/RHCOS, GPU Operator injects the host driver libraries into
+    # /usr/lib64. Prepend that path so this Ubuntu-based DeepStream image uses
+    # the injected host libcuda and libnvidia-ml instead of image placeholders.
+    # This backports NVIDIA correction d1944dfa to the v3.2.1 source lock.
+    export LD_LIBRARY_PATH=/usr/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
     if [[ $MODEL_TYPE == "cnn" ]]; then
           echo "##### $MODEL_TYPE models will be used. #####"
           echo "##### Copying onnx-files to DS docker volume for preserving PVCs... #####"
