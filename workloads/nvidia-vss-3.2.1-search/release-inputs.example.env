# Copy to release-inputs.env and replace every value enclosed in angle brackets.
# Do not add passwords, tokens, API keys, kubeconfigs, or private certificates.

CVD_EXPECTED_API="https://api.<cluster-domain>:6443"
CVD_EXPECTED_CONTEXT="<approved-openshift-context>"
CVD_NAMESPACE="<nvidia-vss-namespace>"
CVD_RELEASE=nvidia-vss-search
CVD_SOURCE_DIR="<absolute-path-to-pinned-nvidia-vss-source>"
CVD_STORAGE_CLASS="<vast-csi-storageclass>"
CVD_ROUTE_HOST="<vss-route-host>"
CVD_STREAMER_ROUTE_HOST="<nvstreamer-route-host>"
CVD_NGC_PULL_SECRET="<ngc-dockerconfig-secret>"
CVD_NGC_API_SECRET="<ngc-api-key-secret>"
CVD_GPU_NODE_SELECTOR_KEY="<gpu-node-label-key>"
CVD_GPU_NODE_SELECTOR_VALUE="<gpu-node-label-value>"
CVD_CPU_NODE_SELECTOR_KEY="<cpu-node-label-key>"
CVD_CPU_NODE_SELECTOR_VALUE="<cpu-node-label-value>"
CVD_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Service origin with explicit port; do not append /v1 or a trailing slash.
CVD_LLM_BASE_URL="<in-cluster-openai-compatible-llm-origin-with-port>"
CVD_KUBE_VERSION="<target-kubernetes-version>"
CVD_HELM_TIMEOUT=45m
CVD_RENDER_DIR="<private-render-directory>"
