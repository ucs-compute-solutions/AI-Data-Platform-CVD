# Copy to release-inputs.env and replace every placeholder.
# Keep the completed file outside source control. Do not put credentials in it.

CVD_EXPECTED_API="https://api.<cluster>.<base-domain>:6443"
CVD_EXPECTED_CONTEXT="<kubeconfig-context>"
CVD_EXPECTED_USER="<cluster-administrator>"

# Private input file used by insightengine/scripts/verify.sh.
# This is a file reference, not a credential. Use an absolute path.
CVD_INSIGHTENGINE_ENV_FILE="/private/path/to/insightengine/release-inputs.env"

CVD_INSIGHTENGINE_NAMESPACE="insight-engine"
CVD_BACKEND_RELEASE="<insightengine-backend-helm-release>"
CVD_BACKEND_DEPLOYMENT="<insightengine-backend-deployment>"
CVD_BACKEND_CONTAINER="backend-webserver"
CVD_BACKEND_BASE_URL="http://127.0.0.1:8080"
CVD_PIPELINE_NAME="<document-ingestion-pipeline>"
CVD_RUNTIME_CONFIG_FILE="/etc/insight-engine/secrets/config.yaml"

# The locked model-smoke validator currently covers this exact local profile.
CVD_NIM_NAMESPACE="nims"
CVD_EMBEDDING_NIMSERVICE="embedding"
CVD_EMBEDDING_BASE_URL="http://embedding.nims.svc:8029"
CVD_EMBEDDING_MODEL="nvidia/llama-nemotron-embed-1b-v2"
CVD_EMBEDDING_DIMENSIONS="2048"
CVD_LLM_NIMSERVICE="llm-nemotron-35-lightning"
CVD_LLM_BASE_URL="http://llm-nemotron-35-lightning.nims.svc:8025"
CVD_LLM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
CVD_RERANKER_NIMSERVICE="reranker"
CVD_RERANKER_BASE_URL="http://reranker.nims.svc:8028"
CVD_RERANKER_MODEL="nvidia/llama-3.2-nv-rerankqa-1b-v2"

CVD_INGEST_TIMEOUT="600"
CVD_RETRIEVE_TIMEOUT="300"
CVD_PROMPT_TIMEOUT="900"
CVD_EMBEDDING_REPEAT="10"
CVD_HELM_TIMEOUT="15m"
