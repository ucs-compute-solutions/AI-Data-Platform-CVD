diff --git a/source-code/video-batch-sync/Dockerfile b/source-code/video-batch-sync/Dockerfile
index 35e1077..4dc179f 100644
--- a/source-code/video-batch-sync/Dockerfile
+++ b/source-code/video-batch-sync/Dockerfile
@@ -1,18 +1,21 @@
-FROM python:3.11-slim
+ARG PYTHON_IMAGE=python:3.11.16-slim-bookworm@sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b
+FROM ${PYTHON_IMAGE}
 
-# Set working directory
 WORKDIR /app
 
-# Copy requirements and install Python dependencies
-COPY requirements.txt .
-RUN pip install --no-cache-dir -r requirements.txt
+COPY requirements.lock .
+RUN python -m pip install --no-cache-dir --requirement requirements.lock \
+    && python -m pip check
 
-# Copy application files from src directory
 COPY src/ ./
 
-# Set environment variables
-ENV PYTHONUNBUFFERED=1
+# OpenShift supplies an arbitrary non-root UID. Group-zero permissions allow
+# that UID to read the application while runtime state remains below /tmp.
+RUN chgrp -R 0 /app \
+    && chmod -R g=u /app
+
+ENV PYTHONUNBUFFERED=1 \
+    HOME=/tmp
 
-# Default command
 CMD ["python", "web_service.py"]
 
