diff --git a/source-code/video-streaming/Dockerfile b/source-code/video-streaming/Dockerfile
index 2d2752a..e36e825 100644
--- a/source-code/video-streaming/Dockerfile
+++ b/source-code/video-streaming/Dockerfile
@@ -1,38 +1,28 @@
-# Match video-backend base (python:3.10-slim) so OpenSSL/glibc match the image that already
-# runs on strict/FIPS Kubernetes workers — avoids streaming-only native TLS/OpenCV mismatches.
-FROM python:3.10-slim
+ARG PYTHON_IMAGE=python:3.11.16-slim-bookworm@sha256:0bee7276f83efd4a1ee05bbbf4281d95ed28e079220a9457f25a93e3f1e3c31b
+FROM ${PYTHON_IMAGE}
 
-# yt-dlp YouTube extraction often needs a JS runtime (n/challenge scripts). Without Node/Deno,
-# you see "No supported JavaScript runtime" and format extraction fails intermittently.
 RUN apt-get update && apt-get install -y --no-install-recommends \
-    ffmpeg \
-    wget \
-    curl \
-    nodejs \
+    ca-certificates=20250419~deb12u1 \
+    ffmpeg=7:5.1.9-0+deb12u1 \
+    nodejs=18.20.4+dfsg-1~deb12u2 \
     && rm -rf /var/lib/apt/lists/* \
+    && ffmpeg -version \
     && node --version
 
-# Set working directory
 WORKDIR /app
 
-# Copy requirements and install Python dependencies
-COPY requirements.txt .
-RUN pip install --no-cache-dir -r requirements.txt
+COPY requirements.lock .
+RUN python -m pip install --no-cache-dir --requirement requirements.lock \
+    && python -m pip check
 
-# Install yt-dlp
-RUN pip install --no-cache-dir yt-dlp
-
-# Copy application files from src directory
 COPY src/ ./
 
-# Create recordings directory
-RUN mkdir -p recordings
-
-# Make scripts executable
-RUN chmod +x *.py
+# OpenShift supplies an arbitrary non-root UID. Temporary MP4 segments are
+# written to the chart's /tmp emptyDir.
+RUN chgrp -R 0 /app \
+    && chmod -R g=u /app
 
-# Set environment variables
-ENV PYTHONUNBUFFERED=1
+ENV PYTHONUNBUFFERED=1 \
+    HOME=/tmp
 
-# Default command
 CMD ["python", "web_service.py"]
