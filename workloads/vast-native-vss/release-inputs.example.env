# Copy to release-inputs.env and replace the site inputs enclosed in angle
# brackets. Leave the two application digest placeholders until the images are
# published, then replace them before rendering or deployment.
# Do not add passwords, tokens, API keys, kubeconfigs, or private certificates.

CVD_EXPECTED_API="https://api.<cluster-domain>:6443"
CVD_EXPECTED_CONTEXT="<approved-openshift-context>"
CVD_NAMESPACE="<vast-vss-namespace>"
CVD_CONTROL_NAMESPACE="<vast-operator-watch-namespace>"
CVD_NIM_NAMESPACE="<nim-namespace>"
CVD_RELEASE="vast-vss"
CVD_ROUTE_HOST="<vast-vss-route-host>"
CVD_SOURCE_DIR="<absolute-path-to-clean-pinned-vast-vss-source>"
CVD_BUILD_DIR="<private-build-directory>"
CVD_RENDER_DIR="<private-render-directory>"
CVD_HELM_TIMEOUT="15m"

# Existing namespace-local Secrets. Values are created through the approved
# secret-management workflow and are never stored in this file.
CVD_IMAGE_PULL_SECRET="<zot-pull-secret>"
CVD_RUNTIME_SECRET="<vast-vss-runtime-secret>"

# Application images. Use immutable sha256 digests, never latest.
CVD_BACKEND_REPOSITORY="<registry-host>/<project>/vss-video-backend"
CVD_BACKEND_DIGEST="sha256:<64-hex-digest>"
CVD_FRONTEND_REPOSITORY="<registry-host>/<project>/vss-video-frontend"
CVD_FRONTEND_DIGEST="sha256:<64-hex-digest>"

# Optional CPU placement label for application and Knative workloads.
CVD_CPU_NODE_SELECTOR_KEY=""
CVD_CPU_NODE_SELECTOR_VALUE=""

# VAST tenant and operator reconciliation inputs.
CVD_TENANT_NAME="<vast-tenant-name>"
CVD_BUCKET_OWNER="<vast-vss-user>"
CVD_VIEW_POLICY="<vast-view-policy>"
CVD_VISIBILITY_GROUP="<dataengine-visibility-group>"
CVD_VMS_CONFIGMAP="<operator-configmap-name>"
CVD_VMS_CONFIG_KEY="config.yaml"
CVD_VMS_HOST_PATH="mgmt.endpoint"
CVD_VMS_USERNAME_PATH="vdb.dataengine_username"
CVD_VMS_SECRET="<operator-credentials-secret>"
CVD_VMS_PASSWORD_KEY="MGMT__PASSWORD"
CVD_BROKER_RESOURCE="<existing-vast-kafka-broker-resource>"
CVD_BROKER_NAME="<existing-vast-event-broker-name>"
CVD_TOPIC_NAME="vss_video_events"

# DataEngine compute and registry assignments.
CVD_DATAENGINE_CLUSTER_VRN="vast:dataengine:kubernetes-clusters:<cluster-name>"
CVD_REGISTRY_NAME="<registry-name-as-configured-in-vms>"
CVD_REGISTRY_PUSH_HOST="<registry-host>"
CVD_FUNCTION_IMAGE_TAG="<explicit-immutable-release-tag>"
CVD_SEGMENTER_ARTIFACT_SOURCE="<registry-project>/vss-video-segmenter"
CVD_REASONER_ARTIFACT_SOURCE="<registry-project>/vss-video-reasoner"
CVD_EMBEDDER_ARTIFACT_SOURCE="<registry-project>/vss-video-embedder"
CVD_WRITER_ARTIFACT_SOURCE="<registry-project>/vss-vastdb-writer"
CVD_PIPELINE_NAME="video-realtime-processing-pipeline"

# Existing local NVIDIA model services.
CVD_EMBEDDING_NIMSERVICE="embedding"
CVD_COSMOS_NIMSERVICE="vss-cosmos-reason2-8b-170"
CVD_LLM_NIMSERVICE="llm-nemotron-35-lightning"
