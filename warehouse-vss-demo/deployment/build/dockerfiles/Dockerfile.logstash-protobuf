ARG BASE_IMAGE=docker.elastic.co/logstash/logstash@sha256:a7ad817ec23e2f9c41f8fcd09bcce3c87710890f93612d4fd51de45074d7af2e
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="NVIDIA VSS Warehouse Logstash protobuf runtime"
LABEL org.opencontainers.image.source="https://github.com/NVIDIA-AI-Blueprints/video-search-and-summarization"
LABEL org.opencontainers.image.revision="7640d917047cf7b0fd3085eefb8282754b56bc94"

USER root
COPY third-party/logstash-offline-plugins-9.3.3-protobuf-1.3.0.zip /tmp/

# The pack must first be generated by Elastic's supported offline-pack process,
# checksum-locked, and copied into this context. Building with network disabled
# then proves that startup does not fetch an unversioned plug-in.
RUN /usr/share/logstash/bin/logstash-plugin install \
      file:///tmp/logstash-offline-plugins-9.3.3-protobuf-1.3.0.zip && \
    rm -f /tmp/logstash-offline-plugins-9.3.3-protobuf-1.3.0.zip

USER 1000
