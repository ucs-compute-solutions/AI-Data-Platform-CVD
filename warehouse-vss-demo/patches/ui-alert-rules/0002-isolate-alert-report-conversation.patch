+import type { Conversation } from '@/types/chat';
+
+export type PendingReport = {
+  conversationId: string;
+  previousConversationId?: string;
+  content: string;
+};
+
+/** Allocate a new report turn without changing or deleting earlier chats. */
+export function createFreshReportConversation(
+  content: string,
+  id: string,
+  conversations: Conversation[],
+  previousConversationId?: string,
+) {
+  if (!content.trim() || !id || conversations.some((item) => item.id === id)) {
+    throw new Error('A report requires a new conversation ID and nonempty prompt');
+  }
+  const conversation: Conversation = {
+    id, name: 'Incident report', messages: [], folderId: null,
+  };
+  return {
+    conversation,
+    conversations: [...conversations, conversation],
+    pending: { conversationId: id, previousConversationId, content } as PendingReport,
+  };
+}
+
+/** Wait for React state AND the sender ref to select the exact fresh chat. */
+export function reportConversationState(
+  pending: PendingReport,
+  selected: Conversation | undefined,
+  current: Conversation | undefined,
+  busy: boolean,
+): 'wait' | 'ready' | 'cancel' {
+  if (!selected || selected.id === pending.previousConversationId) return 'wait';
+  if (selected.id !== pending.conversationId || selected.messages.length !== 0) return 'cancel';
+  if (busy || current?.id !== pending.conversationId) return 'wait';
+  return current.messages.length === 0 ? 'ready' : 'cancel';
+}
