+import React, { useCallback, useState } from 'react';
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { Chat } from '@/components/Chat/Chat';
+import HomeContext from '@/pages/api/home/home.context';
+import { useChatSidebarMainTabBridge } from '../../../../apps/nv-metropolis-bp-vss-ui/hooks/useChatSidebarMainTabBridge';
+import { createSidebarSubmitChatMessage } from '../../../../apps/nv-metropolis-bp-vss-ui/utils/sidebarSubmitChatMessage';
+import { MetadataSection } from '../../../nv-metropolis-bp-vss-ui/alerts/lib-src/components/MetadataSection';
+import MockWebSocket from '../../__mocks__/websocket';
+
+jest.mock('@nemo-agent-toolkit/ui', () => ({ copyToClipboard: jest.fn() }), { virtual: true });
+jest.mock('@nvidia/foundations-react-core', () => ({ Button: ({ children, ...props }: any) => <button {...props}>{children}</button> }));
+
+jest.mock('@/components/Chat/ChatHeader', () => ({ ChatHeader: () => null }));
+jest.mock('@/components/Chat/ChatInput', () => ({ ChatInput: () => null }));
+jest.mock('@/components/Chat/ChatLoader', () => ({ ChatLoader: () => null }));
+jest.mock('@/components/Chat/MemoizedChatMessage', () => ({ MemoizedChatMessage: () => null }));
+jest.mock('@/components/Chat/ChatInteractionMessage', () => ({ InteractionModal: () => null }));
+jest.mock('@/hooks/useUploadFlowCoordinator', () => ({
+  useUploadFlowCoordinator: () => ({ uploadFlowActive: false, uploadFlowActiveRef: { current: false }, reportUploadFlowActive: jest.fn() }),
+}));
+jest.mock('@/utils/app/conversation', () => ({
+  saveConversation: jest.fn(), saveConversations: jest.fn(), updateConversation: jest.fn(),
+}));
+jest.mock('@/utils/app/api', () => ({ getEndpoint: () => 'api/chat' }));
+jest.mock('uuid', () => {
+  let count = 0;
+  return { v4: () => `new-uuid-${++count}` };
+});
+
+const old = {
+  id: 'old-conversation', name: 'Earlier report', folderId: null,
+  messages: [{ role: 'assistant', content: 'The earlier incident does not exist.' }],
+};
+
+function mountChat(busy = false, websocket = false) {
+  let submit: (text: string, options?: { freshConversation?: boolean }) => void;
+  let observed: any;
+  let setBusy: () => void;
+  function Harness() {
+    const [state, setState] = useState<any>({
+      selectedConversation: old, conversations: [old], messageIsStreaming: busy,
+      loading: busy, chatHistory: true, webSocketMode: websocket, webSocketConnected: false,
+      webSocketURL: 'ws://localhost/websocket',
+    });
+    observed = state;
+    setBusy = () => setState((current: any) => ({ ...current, loading: true, messageIsStreaming: true }));
+    const bridge = useChatSidebarMainTabBridge({ activeTab: 'alerts', sidebarCollapsed: false });
+    const sidebarSubmit = createSidebarSubmitChatMessage(bridge.submitSidebarMessage, bridge.highlightSidebarWhenCollapsed);
+    const dispatch = useCallback(({ field, value }: any) => {
+      setState((current: any) => current[field] === value ? current : ({ ...current, [field]: value }));
+    }, []);
+    return <HomeContext.Provider value={{
+      state, storageKeyPrefix: 'report-test',
+      dispatch,
+      handleUpdateConversation: jest.fn(), onSubmitMessageReady: (callback: any) => { submit = callback; bridge.handleSidebarSubmitMessageReady(callback); },
+    } as any}><Chat /><MetadataSection alertId="2b78d59d057ce1a60408d83f684da9310d96ed17"
+      sensor="Camera" title="Metadata" data={{ sensorId: 'Camera' }} isDark
+      alertReportPromptTemplate="Generate a report for incident {incidentId} with sensor id {sensorId}."
+      submitChatMessage={sidebarSubmit} /></HomeContext.Provider>;
+  }
+  render(<Harness />);
+  if (busy) act(() => setBusy());
+  return { submit: (...args: Parameters<typeof submit>) => submit(...args), state: () => observed };
+}
+
+describe('Generate Report actual HTTP conversation binding', () => {
+  beforeEach(() => {
+    sessionStorage.clear();
+    (sessionStorage.getItem as jest.Mock).mockReturnValue(null);
+    MockWebSocket.lastInstance = null;
+    global.fetch = jest.fn(() => new Promise(() => {}));
+    Element.prototype.scrollIntoView = jest.fn();
+  });
+
+  it('sends once only after selecting fresh UUID; retains old chat but excludes its messages', async () => {
+    const h = mountChat();
+    act(() => {
+      h.submit('Generate report for new incident', { freshConversation: true });
+      h.submit('duplicate click', { freshConversation: true });
+    });
+    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+    const [, request] = (fetch as jest.Mock).mock.calls[0];
+    const selected = h.state().selectedConversation;
+    expect(request.headers['Conversation-Id']).toBe(selected.id);
+    expect(selected.id).not.toBe(old.id);
+    expect(JSON.parse(request.body).messages).toEqual([{ role: 'user', content: 'Generate report for new incident' }]);
+    expect(h.state().conversations[0]).toEqual(old);
+    expect(h.state().conversations).toHaveLength(2);
+  });
+
+  it('does not create or send a report while the existing query is active', () => {
+    const h = mountChat(true);
+    act(() => h.submit('Generate report', { freshConversation: true }));
+    expect(fetch).not.toHaveBeenCalled();
+    expect(h.state().conversations).toEqual([old]);
+  });
+
+  it('forwards actual Generate Report through Home callback, app bridge and Chat into a new HTTP identity', async () => {
+    const h = mountChat();
+    fireEvent.click(screen.getByRole('button', { name: 'Generate Report' }));
+    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+    const [, request] = (fetch as jest.Mock).mock.calls[0];
+    expect(request.headers['Conversation-Id']).toBe(h.state().selectedConversation.id);
+    expect(request.headers['Conversation-Id']).not.toBe(old.id);
+    expect(JSON.parse(request.body).messages).toEqual([{ role: 'user', content: 'Generate a report for incident 2b78d59d057ce1a60408d83f684da9310d96ed17 with sensor id Camera.' }]);
+    expect(h.state().conversations[0]).toEqual(old);
+  });
+
+  it('leaves ordinary chat in the existing conversation with its history', async () => {
+    const h = mountChat();
+    act(() => h.submit('ordinary follow-up'));
+    await waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+    const [, request] = (fetch as jest.Mock).mock.calls[0];
+    expect(request.headers['Conversation-Id']).toBe(old.id);
+    expect(JSON.parse(request.body).messages).toEqual([...old.messages, { role: 'user', content: 'ordinary follow-up' }]);
+  });
+
+  it('uses the same newly allocated UUID in the actual WebSocket report request', async () => {
+    const h = mountChat(false, true);
+    const socket = MockWebSocket.lastInstance!;
+    socket.send = jest.fn();
+    act(() => socket.mockOpen());
+    fireEvent.click(screen.getByRole('button', { name: 'Generate Report' }));
+    await waitFor(() => expect(socket.send).toHaveBeenCalledTimes(1));
+    const request = JSON.parse(socket.send.mock.calls[0][0]);
+    expect(request.conversation_id).toBe(h.state().selectedConversation.id);
+    expect(request.conversation_id).not.toBe(old.id);
+    expect(request.content.messages).toEqual([{ role: 'user', content: [{ type: 'text', text: 'Generate a report for incident 2b78d59d057ce1a60408d83f684da9310d96ed17 with sensor id Camera.' }] }]);
+    expect(fetch).not.toHaveBeenCalled();
+    expect(h.state().conversations[0]).toEqual(old);
+  });
+});
