+};
+
+describe('Independent alert report conversations', () => {
+  test('creates an empty separate identity and retains every previous chat', () => {
+    const before = JSON.stringify(old);
+    const fresh = createFreshReportConversation('Report incident abc', 'new-uuid', [old], old.id);
+    expect(fresh.conversation.id).not.toBe(old.id);
+    expect(fresh.conversation.messages).toEqual([]);
+    expect(fresh.conversations).toEqual([old, fresh.conversation]);
+    expect(JSON.stringify(old)).toBe(before);
+    expect(fresh.pending.content).toBe('Report incident abc');
+  });
+
+  test('waits for selected state and sender ref; never sends to old conversation', () => {
+    const fresh = createFreshReportConversation('Report abc', 'new-uuid', [old], old.id);
+    expect(reportConversationState(fresh.pending, old, old, false)).toBe('wait');
+    expect(reportConversationState(fresh.pending, fresh.conversation, old, false)).toBe('wait');
+    expect(reportConversationState(fresh.pending, fresh.conversation, fresh.conversation, false)).toBe('ready');
+  });
+
+  test('does not send while another query or upload is active', () => {
+    const fresh = createFreshReportConversation('Report abc', 'new-uuid', [old], old.id);
+    expect(reportConversationState(fresh.pending, fresh.conversation, fresh.conversation, true)).toBe('wait');
+  });
+
+  test('cancels rather than sending into a different user-selected chat', () => {
+    const fresh = createFreshReportConversation('Report abc', 'new-uuid', [old], old.id);
+    const other = { ...fresh.conversation, id: 'other-chat' };
+    expect(reportConversationState(fresh.pending, other, other, false)).toBe('cancel');
+  });
+
+  test('refuses nonempty target history even with the expected fresh ID', () => {
+    const fresh = createFreshReportConversation('Report abc', 'new-uuid', [old], old.id);
+    const polluted = { ...fresh.conversation, messages: old.messages };
+    expect(reportConversationState(fresh.pending, polluted, polluted, false)).toBe('cancel');
+    expect(reportConversationState(fresh.pending, fresh.conversation, polluted, false)).toBe('cancel');
+  });
+
+  test('every repeat report receives another empty identity without deleting first report', () => {
+    const first = createFreshReportConversation('Report abc', 'first-uuid', [old], old.id);
+    const second = createFreshReportConversation('Report abc', 'second-uuid', first.conversations, first.conversation.id);
+    expect(second.conversations.map((item) => item.id)).toEqual(['old-chat', 'first-uuid', 'second-uuid']);
+    expect(second.conversation.messages).toEqual([]);
+  });
+
+  test('refuses reused IDs and empty prompts', () => {
+    expect(() => createFreshReportConversation('Report abc', old.id, [old])).toThrow();
+    expect(() => createFreshReportConversation(' ', 'new-uuid', [old])).toThrow();
+  });
+});
