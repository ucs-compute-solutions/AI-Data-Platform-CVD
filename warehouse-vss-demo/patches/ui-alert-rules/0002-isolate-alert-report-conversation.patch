+// SPDX-License-Identifier: MIT
+/** Home's shared callback must preserve report isolation through the app shell. */
+export function createSidebarSubmitChatMessage(
+  submit: (message: string, options?: { freshConversation?: boolean }) => void,
+  highlight: () => void,
+) {
+  return (message: string, options?: { freshConversation?: boolean }) => {
+    submit(message, options);
+    highlight();
+  };
+}
