+void GstDeMux::armReplayEpoch(guint32 seqnum)
+{
+    if (seqnum == GST_SEQNUM_INVALID)
+    {
+        LOG(error) << "Cannot arm replay with an invalid seqnum, session:" << m_sessionId << endl;
+        return;
+    }
+    std::lock_guard<std::mutex> guard(m_replayEpochLock);
+    m_replaySeekSucceeded = false;
+    m_expectedReplaySeqnum = seqnum;
+    m_prearmedReplaySeqnum = seqnum;
+    LOG(info) << "Armed replay seek, session:" << m_sessionId
+              << ", seqnum:" << seqnum << endl;
+}
+
+bool GstDeMux::consumePrearmedReplaySeek(guint32 seqnum)
+{
+    std::lock_guard<std::mutex> guard(m_replayEpochLock);
+    if (seqnum == GST_SEQNUM_INVALID || m_prearmedReplaySeqnum != seqnum ||
+        m_expectedReplaySeqnum != seqnum || m_replaySeekSucceeded)
+    {
+        LOG(error) << "Rejecting superseded replay seek, session:" << m_sessionId
+                   << ", requestedSeqnum:" << seqnum
+                   << ", expectedSeqnum:" << m_expectedReplaySeqnum << endl;
+        return false;
+    }
+    m_prearmedReplaySeqnum = GST_SEQNUM_INVALID;
+    return true;
+}
+
+void GstDeMux::completeReplaySeek(guint32 seqnum, bool succeeded)
+{
+    std::lock_guard<std::mutex> guard(m_replayEpochLock);
+    if (m_expectedReplaySeqnum == seqnum)
+    {
+        m_replaySeekSucceeded = succeeded;
+    }
+    LOG(info) << "Replay seek result, session:" << m_sessionId
+              << ", seqnum:" << seqnum << ", succeeded:" << succeeded << endl;
+}
+
+bool GstDeMux::acceptsReplayEos(guint32 messageSeqnum)
+{
+    std::lock_guard<std::mutex> guard(m_replayEpochLock);
+    /* The first playback has no application-issued seek. After the first
+     * replay, require the EOS message to match that loop's seek seqnum. */
+    const bool accepted = m_replaySeekSucceeded &&
+        (m_expectedReplaySeqnum == GST_SEQNUM_INVALID ||
+         m_expectedReplaySeqnum == messageSeqnum);
+    if (!accepted)
+    {
+        LOG(info) << "Rejected replay EOS, session:" << m_sessionId
+                  << ", expectedSeqnum:" << m_expectedReplaySeqnum
+                  << ", messageSeqnum:" << messageSeqnum
+                  << ", seekSucceeded:" << m_replaySeekSucceeded << endl;
+    }
+    return accepted;
+}
