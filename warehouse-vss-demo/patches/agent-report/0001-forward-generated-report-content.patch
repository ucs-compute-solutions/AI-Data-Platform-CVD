+def _bounded_report_content(report_result: Any) -> str:
+    """Pass generated report evidence to the top agent without unbounded context."""
+    if isinstance(report_result, dict):
+        content = report_result.get("content")
+    else:
+        content = getattr(report_result, "content", None)
+    if not isinstance(content, str) or not content.strip():
+        raise ValueError("template_report_gen returned no report content")
+    content = content.strip()
+    if len(content) > _MAX_REPORT_CONTEXT_CHARS:
+        content = (
+            content[:_MAX_REPORT_CONTEXT_CHARS].rstrip()
+            + "\n\n[Report excerpt truncated; use the appended Markdown report link for the full text.]"
+        )
+    return content
+
