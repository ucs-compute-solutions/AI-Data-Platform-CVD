# Copy to release-inputs.env and replace every REQUIRED value.
# Do not commit the completed file or any referenced site-values file.

EXPECTED_OCP_API="https://api.<cluster>.<base-domain>:6443" # REQUIRED
EXPECTED_OCP_CONTEXT="<kubeconfig-context>"                 # REQUIRED
EXPECTED_OCP_USER="<cluster-administrator>"                 # REQUIRED

INSIGHTENGINE_BUNDLE_DIR="/path/to/insight-engine-v5.4-delivery-<version>" # REQUIRED
EXPECTED_IE_VERSION="5.4.3"                                               # This companion is release-bounded
INSIGHTENGINE_NAMESPACE="insight-engine"
PIPELINE_NAME="<pipeline-name>"                             # REQUIRED
# Optional comma-separated VMSKafkaTopic.spec.topicName values when the site
# provisions auxiliary audit/metrics/status topics as VAST custom resources.
# The backend chart does not create these topic CRs; the pipeline topic is
# verified separately through IngestionPipeline.spec.topic.
EXPECTED_AUXILIARY_TOPIC_NAMES=""
PIPELINE_TOPIC_NAME="<dedicated-pipeline-topic>"                # REQUIRED
PIPELINE_BROKER_NAME="<existing-vast-event-broker>"              # REQUIRED; IngestionPipeline.spec.topic.broker
EXPECTED_VMS_BROKER_CR_NAME="<vms-kafka-broker-cr-name>"        # REQUIRED
EXPECTED_VAST_BROKER_NAME="<existing-vast-event-broker>"        # REQUIRED; VMSKafkaBroker.spec.brokerName
EXPECTED_VMS_USER_CR_NAME="<vms-user-cr-name>"                 # REQUIRED
EXPECTED_VMS_GROUP_CR_NAME="<vms-group-cr-name>"               # REQUIRED
EXPECTED_END_USER_POLICY_CR_NAME="<vms-end-user-policy-cr-name>" # REQUIRED
EXPECTED_S3_VIEW_CR_NAME="<vms-view-cr-name>"                  # REQUIRED
EXPECTED_VDB_VIEW_CR_NAME="<vms-vdb-view-cr-name>"             # REQUIRED

POSTGRES_RELEASE="<postgres-release>"                       # REQUIRED
OPERATOR_RELEASE="<operator-release>"                       # REQUIRED
BACKEND_RELEASE="<backend-release>"                         # REQUIRED

# Chart paths are relative to INSIGHTENGINE_BUNDLE_DIR. The companion rejects
# absolute paths, traversal, symlinks, and files outside that delivery.
POSTGRES_CHART="charts/postgresql-<version>.tgz"              # REQUIRED
OPERATOR_CHART="charts/insight-engine-operator-<version>.tgz" # REQUIRED
BACKEND_CHART="charts/insight-engine-backend-<version>.tgz"   # REQUIRED

# Use reviewed regular files, not symlinks. Review mode hashes these exact files
# and apply mode refuses any later change.
POSTGRES_VALUES="/path/to/reviewed/postgresql-values.yaml"   # REQUIRED
OPERATOR_VALUES="/path/to/reviewed/ie-operator.yaml"         # REQUIRED
BACKEND_VALUES="/path/to/reviewed/ie-config.yaml"            # REQUIRED
POSTGRES_SERVICE_NAME="<postgres-release>-postgresql"         # REQUIRED
POSTGRES_SERVICE_HOST="<postgres-release>-postgresql.<namespace>.svc.cluster.local" # REQUIRED
S3_VIEW_POLICY_NAME="<existing-site-s3-policy>"                # REQUIRED
END_USER_POLICY_NAME="EndUserVastDBPolicy-<tenant>"            # REQUIRED
EXPECTED_APP_MANAGER_USERNAME="<insightengine-manager-username>" # REQUIRED

REGISTRY_TARGET="<registry-host>/<registry-project>"         # REQUIRED; image push destination
INGEST_REGISTRY_NAME="<vast-dataengine-registry-name>"        # REQUIRED; IngestionPipeline registry reference
INGEST_K8S_CLUSTER_NAME="<vast-dataengine-kubernetes-cluster-name>" # REQUIRED
INGEST_IMAGE_REPOSITORY="<ingestion-image-repository>"        # REQUIRED; excludes the registry prefix
INGEST_IMAGE_TAG="5.4.3"                                     # REQUIRED; never latest
# The VAST registry record supports secret, password, or none. A Kubernetes
# dockerconfig Secret is required only when this value is secret.
INGEST_REGISTRY_AUTH_TYPE="secret"
INGEST_PULL_SECRET_NAME="<dataengine-registry-pull-secret>"
EXPECTED_EMBEDDING_MODEL="<embedding-model-name>"              # REQUIRED
EXPECTED_EMBEDDING_DIMENSIONS="<embedding-vector-dimensions>"  # REQUIRED
STORAGE_CLASS="<vast-storage-class>"                          # REQUIRED
EXPECTED_CSI_PROVISIONER="csi.vastdata.com"

RUNTIME_SECRET_NAME="insight-engine-secrets"
POSTGRES_SECRET_NAME="insight-engine-postgresql-auth"
APP_PULL_SECRET_NAME="registry-pull-secret"
# NVIDIA_API_KEY is intentionally omitted here for local NIM endpoints. Add it
# only when the selected release and hosted endpoint require it.
RUNTIME_SECRET_REQUIRED_KEYS="MGMT__USERNAME,MGMT__PASSWORD,BACKEND_WEBSERVER_JWT_SECRET_KEY,OAUTH2__CLIENT_ID,OAUTH2__CLIENT_SECRET,POSTGRES__PASSWORD,VDB__ACCESS_KEY,VDB__SECRET_KEY,BACKEND_S3_ACCESS__AWS_ACCESS_KEY,BACKEND_S3_ACCESS__AWS_SECRET_ACCESS_KEY"
POSTGRES_SECRET_REQUIRED_KEYS="password,postgres-password"

DATAENGINE_NAMESPACE="vast-dataengine"
KNATIVE_SERVING_NAMESPACE="knative-serving"
KNATIVE_EVENTING_NAMESPACE="knative-eventing"

# Set to true only after a VAST administrator confirms both the compute-cluster
# namespace selection and the saved registry association for this namespace.
VAST_MAPPING_CONFIRMED="false"
# Set to true only after completing the selected release's VAST provisioning
# step, or after verifying every prerequisite of the accepted pre-provisioned path.
VAST_PREREQUISITES_CONFIRMED="false"
# Set to true only after confirming that runtime MGMT__USERNAME/MGMT__PASSWORD
# exactly match vms.username and the APP_USER_PASSWORD used during provisioning.
MANAGER_CREDENTIAL_MATCH_CONFIRMED="false"
# Set to true only after the VAST administrator attaches END_USER_POLICY_NAME
# to every local user that will query InsightEngine. The policy is created by
# the backend/operator, so set this only after Helm deployment and assignment.
END_USER_POLICY_ASSIGNMENT_CONFIRMED="false"
# Set to true only after the cluster and workloads trust the required VAST,
# registry, and model-endpoint certificate authorities. Never bypass TLS.
TRUSTED_CA_CONFIRMED="false"

# The companion does not run the vendor provisioning utility or collect VAST
# administrator credentials. Record which reviewed path was completed.
PROVISIONING_MODE="<vendor-helper-or-preprovisioned>"
