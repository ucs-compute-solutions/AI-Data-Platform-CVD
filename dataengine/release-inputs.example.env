# Copy to release-inputs.env and replace every REQUIRED value.
# Do not commit the completed file.

EXPECTED_OCP_API="https://api.<cluster>.<base-domain>:6443" # REQUIRED

ZOT_NAMESPACE="zot"
ZOT_RELEASE="zot"
ZOT_CHART_VERSION="0.1.113"
ZOT_HOST="zot.apps.<cluster>.<base-domain>"                 # REQUIRED
ZOT_USER="<registry-user>"                                  # REQUIRED
ZOT_STORAGE_CLASS="<storage-class>"                         # REQUIRED
ZOT_STORAGE_SIZE="50Gi"
INGRESS_CLASS="openshift-default"
REGISTRY_TRUST_CONFIGMAP="custom-registry-ca"
# Optional PEM bundle for a custom ingress certificate. Leave empty to extract
# the OpenShift default ingress CA from openshift-config-managed.
ZOT_CA_BUNDLE=""

VAST_PERMISSIONS_NAMESPACE="vast-permissions"
VAST_PERMISSIONS_RELEASE="vast-permissions"
VAST_PERMISSIONS_CHART="/path/to/release-supplied/vast-permissions-chart" # REQUIRED
VAST_PERMISSIONS_VALUES="permissions/vast-permissions-values.yaml"

DATAENGINE_BUNDLE_DIR="/path/to/vast-dataengine-release-bundle"           # REQUIRED
ZARF_INIT_PACKAGE="zarf-init-amd64-<release>.tar.zst"                      # REQUIRED when Zarf is not initialized
ZARF_ARCHITECTURE="amd64"
ZARF_BINARY_SHA256="<sha256-from-vast-release>"                            # REQUIRED
ZARF_INIT_PACKAGE_SHA256="<sha256-from-vast-release>"                      # REQUIRED when Zarf is not initialized
DATAENGINE_PACKAGE="zarf-package-dataengine-amd64-<release>.tar.zst"       # REQUIRED
DATAENGINE_PACKAGE_SHA256="<sha256-from-vast-release>"                     # REQUIRED

DATAENGINE_NAMESPACE="vast-dataengine"
KNATIVE_SERVING_NAMESPACE="knative-serving"
KNATIVE_EVENTING_NAMESPACE="knative-eventing"
# Comma-separated, reviewed allowlist. Zarf mutation is denied everywhere
# else by the labeled mutation policy selected during initialization.
ZARF_MUTATION_NAMESPACES="vast-dataengine,knative-serving,knative-eventing"
